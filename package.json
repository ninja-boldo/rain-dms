{
  "name": "rain-dms",
  "license": "MIT",
  "scripts": {
    "setup": "bash backend/certs/create_certs.sh",
    "dev": "bun run setup && bun run dev::backend",
    "dev::backend": "cd backend && bun run --env-file=../.env dev",
    "dev::backend::db": "cd backend && bunx drizzle-kit push",
    "dev::frontend": "cd frontend && bun run dev --host 0.0.0.0",
    "dev::all": "bun run setup && concurrently \"ROOT_DIR=$(pwd) bun run dev::backend\" \"bun run dev::frontend\""
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/jsonwebtoken": "^9.0.10",
    "mitata": "^1.0.34"
  },
  "supportedArchitectures": {
    "os": [
      "current",
      "linux",
      "darwin"
    ],
    "cpu": [
      "current",
      "x64",
      "arm64"
    ],
    "libc": [
      "current",
      "glibc",
      "musl"
    ]
  },
  "trustedDependencies": [
    "@kreuzberg/node",
    "esbuild",
    "kreuzberg",
    "onnxruntime-node",
    "protobufjs",
    "sharp",
    "tesseract.js"
  ]
}
